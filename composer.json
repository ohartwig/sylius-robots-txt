{
    "name": "koh/sylius-robots-txt",
    "description": "Channel-aware robots.txt for Sylius with explicit AI crawler rules and Content Signals (RFC 9309).",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "robots.txt",
        "ai",
        "crawler",
        "content-signals",
        "agent"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source/sylius-agent-ready",
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/sylius-robots-txt/-/issues",
        "source": "https://github.com/ole-hartwig/sylius-robots-txt"
    },
    "require": {
        "php": "^8.2",
        "koh/sylius-agent-contracts": "^1.0",
        "sylius/sylius": "^2.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusRobotsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusRobotsTxt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ]
}
