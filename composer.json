{
    "name": "koh/sylius-robots-txt",
    "description": "Channel-aware robots.txt for Sylius with explicit AI crawler rules and Content Signals (RFC 9309).",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "robots.txt",
        "ai",
        "crawler",
        "content-signals",
        "agent"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://github.com/ohartwig/sylius-robots-txt",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-robots-txt/issues",
        "source": "https://github.com/ohartwig/sylius-robots-txt"
    },
    "require": {
        "php": "^8.3",
        "koh/sylius-agent-contracts": "^1.0",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusRobotsTxt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusRobotsTxt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ]
}
